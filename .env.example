# TestNet spike environment template. Copy to .env and fill in real values;
# .env is gitignored and must never be committed.

# Algorand TestNet node endpoints. Leave empty to fall back to the public
# AlgoNode TestNet endpoints.
ALGOD_TESTNET_URL=
INDEXER_TESTNET_URL=

# GoPlausible x402 facilitator. Public URL, not a secret.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# TestNet USDC ASA id, confirmed via vendored algorand-x402-python skill references
USDC_TESTNET_ASA_ID=10458941

# Escrow application, set once it is deployed.
APP_ID=
APP_ACCOUNT=

# Buyer key material. Never fill in outside a local, gitignored .env file.
AVM_PRIVATE_KEY=
AVM_BUYER_MNEMONIC=

# Host the resource server (api/server.py) is reachable at.
RESOURCE_HOST=http://localhost:8000

# --- Facilitator-independent dry run (tests/dry_run_join_group.py) ---
# A second application instance bound to whatever asset the dry-run buyer
# actually holds, plus a throwaway account that signs the fee-payer leg in
# place of the facilitator. All five are required by that script.
DRYRUN_APP_ID=
DRYRUN_APP_ACCOUNT=
DRYRUN_ASSET_ID=
# Key material. Never fill in outside a local, gitignored .env file.
DRYRUN_FEE_PAYER_KEY=
DRYRUN_FEE_PAYER_ADDRESS=

# =====================================================================
# Delivery-escrow backend (api/config.py)
# =====================================================================
# Every variable below is read by `load_settings`, and a test asserts that
# this file documents all of them -- a value added to the code or to the
# deployment and to no document is the drift that has already bitten once.
#
# The guards these feed refuse to boot rather than serve a wrong 402. That is
# deliberate: the challenge tag is stamped at settlement and never
# reclassified, so a first MainNet settlement served from a bad configuration
# cannot be repaired afterwards.

# --- routes served ---------------------------------------------------
# Whether POST /pin (the delivery escrow) is served: true or false, default
# false. Its delivery half -- the upload, leg 2 and the release -- is not
# built, so a deployment serving it makes the admin key sign a create for every
# unpaid quote and takes payments that can only ever be refunded. Off, the
# server needs no PRICE_MICRO_USDC, refuses to boot while ADMIN_MNEMONIC is
# set, and /pin answers 404.
# On is refused on MainNet at boot. POST /index is always served.
PIN_ROUTE_ENABLED=

# The built browser client (`npm run build` in web/), served under /app/ with
# / and /app redirecting there. Served only when this directory exists; a
# directory with no index.html refuses to boot. Relative paths resolve against
# the working directory. Defaults to web/dist.
WEB_DIST_DIR=

# --- network ---------------------------------------------------------
# CAIP-2 network id. The network/asset guard allows exactly two pairs:
# MainNet with 31566704, TestNet with 10458941. Anything else refuses.
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
USDC_ASA_ID=10458941
# Leave empty to fall back to the SDK's public endpoint for the network.
ALGOD_URL=
ALGOD_TOKEN=

# --- the escrow application ------------------------------------------
# APP_ACCOUNT must be the address derived from APP_ID or the server refuses to
# boot, and the account must be funded and opted in to USDC_ASA_ID before the
# endpoint can answer a 402 it is able to honour. A frozen holding also
# refuses: opt-in is only half of it, and MainNet USDC declares a freeze
# address.
APP_ID=
APP_ACCOUNT=
# Set on MainNet deployments only. If this id appears in a non-MainNet
# configuration the server refuses to boot -- development and production are
# different applications, and therefore different merchant identities.
PRODUCTION_APP_ID=

# --- addresses -------------------------------------------------------
# Advertised in price.extra. The facilitator overwrites it with its own
# sponsor address when it has one, but a missing value refuses to boot.
FEE_PAYER=
# `hash` agreements pay the treasury, which fronts the leg-2 fee from float.
TREASURY=
# Per agreement and immutable. Only this address can release.
VERIFIER=

# --- signing material ------------------------------------------------
# The escrow admin. Creating an agreement is an admin call, so a server serving
# POST /pin is the admin and cannot run keyless. With PIN_ROUTE_ENABLED off the
# server refuses to boot while this is set: a pool-only host holds no key, so
# never set it as that host's secret, and start a local server with it emptied
# (ADMIN_MNEMONIC= uvicorn ...). The operator scripts in agents/ sign with it
# either way. NEVER commit a value here; on a host that does serve POST /pin it
# is a platform secret, never a build-time env value.
ADMIN_MNEMONIC=

# --- public identity -------------------------------------------------
# RESOURCE_URL must be https:// and on PUBLIC_HOST. It pins the catalogue
# identity: the server builds that from `resource or adapter.get_url()`, and
# get_url() includes the query string, so an unpinned route taking its input
# in the query registers one near-duplicate directory row per distinct query.
# Defaults to PUBLIC_HOST + "/pin".
PUBLIC_HOST=https://earnest.example
RESOURCE_URL=
# The pool route's catalogue identity, same rules as RESOURCE_URL above. Both
# products share one payTo, and the challenge tag must be correct on both
# before either settles once -- attribution is stamped at settlement and is
# never reclassified. Defaults to PUBLIC_HOST + "/index".
INDEX_RESOURCE_URL=
# The pool route's description: its public catalogue listing, and what a
# discovering agent reads before it pays. Empty means the default listing in
# api/config.py. An override must keep every one of these clauses, matched
# case-sensitively -- "join call", "sha256", "refunded", "Machine-verified",
# "no arbitration" and "One seat per address" -- or the server refuses to boot.
# The join-call sentence is what stops a buyer sending a transfer that is not
# a purchase and cannot be recovered; the rest are the terms of the sale.
INDEX_DESCRIPTION=

# --- commercial parameters -------------------------------------------
# All amounts in the asset's smallest unit (USDC has six decimals).
# The delivery-escrow route's price, in micro-USDC.
# Required only while PIN_ROUTE_ENABLED is on.
PRICE_MICRO_USDC=2000000
# One pool seat, in micro-USDC. Five seats at $5.00 is the edition's pool.
INDEX_SHARE_PRICE_MICRO=5000000
# Seats per pool. Fixed at creation -- min_seats == max_seats, so this cannot
# be tuned after an agreement exists. Ceiling is 20.
INDEX_SEATS=5
# The agreement id of the pool this deployment currently serves. Empty (or 0)
# means no pool is configured, and POST /index answers 503 rather than
# guessing -- an unbounded flood of unrelated, unpaid /pin quotes can push the
# real open pool past any bounded scan. Set this after `agents/create_pool.py`
# prints the id of a newly created pool, and again each time an edition's pool
# closes and the next one opens; leave it empty between editions.
INDEX_AGREEMENT_ID=
# Bounds treasury exposure. Expressed in USDC rather than in a job count,
# because the leg-2 price is derived from file size and a count does not
# bound the money.
MAX_LEG2_MICRO_USDC=500000
# The funding window is backend policy and must equal every paid route's
# max_timeout_seconds, or the 402 advertises time the sweeper takes back.
FUNDING_WINDOW_SECONDS=120
# Sized for delivery alone: upload, leg 2, pinning, gateway propagation and
# the release transaction. Gateway propagation is the long pole.
DELIVERY_DEADLINE_SECONDS=900
# Bounds the money and the memory: the leg-2 client must materialise the whole
# multipart body rather than stream it.
MAX_FILE_BYTES=16777216
# Ceiling on concurrently unfunded agreements. Every quote parks an ALGO
# deposit, so the capacity to quote is the binding constraint, not loss.
MAX_UNFUNDED_AGREEMENTS=50
# Per-source rate limit on unpaid quote requests, rolling one-minute window.
# The ceiling above bounds the total; this bounds how fast any one caller can
# reach it on its own.
QUOTES_PER_SOURCE_PER_MINUTE=20
# How long the 402 may spend creating an agreement before the request is given
# up on. x402-avm's own default is no timeout at all, so leaving this unset
# means a chain that stops answering holds the buyer's request open
# indefinitely. Must be inside FUNDING_WINDOW_SECONDS -- boot refuses
# otherwise -- since a quote that consumed the whole window would leave no
# time to pay in. The create itself is bounded (it waits four rounds), so this
# is the outer bound rather than the expected duration.
PRICE_HOOK_TIMEOUT_SECONDS=60

# --- operator tooling (agents/, not the server) -----------------------
# Read by `agents/create_pool.py`, never by `load_settings`: the server has no
# use for it. flyctl's own variable for the `-a/--app` flag, so `fly` reads it
# too and a `fly secrets set` typed without `-a` still lands on the right app.
# `create_pool` prints its refresh step with the app whose `fly*.toml` in this
# repository serves `APP_ID`, and reads this only for an application no config
# here serves: set it to that application's app to have the step come out
# complete, ready to paste. Left empty, that step prints `-a <app>` for you to
# fill in, which is the only cost of not setting it.
#
# It is NOT Fly's in-machine `FLY_APP_NAME`: `create_pool` holds the admin key
# and runs from the operator's machine, never inside the deployed app.
FLY_APP=

# --- leg 2 -----------------------------------------------------------
WORKER_URL=https://api.algofile.io/api/algofile/upload
# Public IPFS gateway the CID is re-fetched from for verification. Which one
# is still open; the first MainNet rehearsal decides it.
GATEWAY_URL=

# --- storage ---------------------------------------------------------
# SQLite file holding the job records. It maps jobId to agreement; losing it
# leaves funded buyers unable to upload until their deadline refunds them.
JOB_DB_PATH=jobs.sqlite3

# --- end-to-end circuit test (tests/e2e) ------------------------------
# Read by tests/e2e, never by the server. `python -m agents.e2e_bootstrap`
# generates the accounts and writes these; it prints addresses only, never a
# mnemonic, which is the point of it being a script.
#
# The suite settles real TestNet payments, so it is opt-in twice over: it skips
# itself unless E2E_ENABLED is set, and CI filters the marker out as well.
E2E_ENABLED=
# The buyer. Distinct from ADMIN_MNEMONIC, TREASURY and VERIFIER -- four roles,
# four accounts. Its USDC recirculates rather than draining: a release pays the
# treasury and the teardown sends it back, a refund returns it directly. TestNet
# USDC has no programmatic dispenser, so that balance is the scarce thing here.
E2E_BUYER_MNEMONIC=
# The verifier's key. The address is VERIFIER above; the spec requires it be a
# different key from the admin, since an admin who could also release would make
# the release condition a promise rather than a constraint.
E2E_VERIFIER_MNEMONIC=
# The treasury's key. The address is TREASURY above. Held so the suite can send
# a released payment back to the buyer on teardown.
E2E_TREASURY_MNEMONIC=
# Overrides DELIVERY_DEADLINE_SECONDS for the suite alone. There is no timestamp
# offset on TestNet, so the refund scenario waits this out in real seconds.
E2E_DEADLINE_SECONDS=120

# The multi-seat rehearsal (tests/e2e/test_multi_seat_rehearsal.py) is gated a
# third time, beyond E2E_ENABLED and the marker: it spends thirteen settlements
# and waits out two real deadlines. Leave empty to skip it.
E2E_REHEARSAL=
# The edition release scenario (tests/e2e/test_edition_release.py) needs a
# rehearsal bundle: a small edition-<N>.json that is NOT a real edition, and its
# manifest, pinned with the pinning provider. A release note publishes its CID,
# and a real edition's CID is what seat holders pay for, so never point these at
# a real edition. Leave both empty to skip that scenario.
E2E_EDITION_MANIFEST=
E2E_EDITION_CID=
# Written by `python -m agents.seat_accounts provision`, never by hand. A
# five-seat pool needs five distinct payers because `join` refuses a payer
# already on the roster, and this suite's buyer is only one of them; these are
# the throwaway accounts that make up the difference. Numbered from 1 with no
# gaps -- seat numbering is positional, so a hole would renumber every seat
# after it. Key material: never commit a filled-in value.
E2E_SEAT_1_MNEMONIC=
E2E_SEAT_2_MNEMONIC=
E2E_SEAT_3_MNEMONIC=
E2E_SEAT_4_MNEMONIC=

# --- browser client --------------------------------------------------
# The client's own variables live in web/.env.example and are compiled into
# the bundle at build time rather than read from here. Three of them must
# agree with values above -- NETWORK, USDC_ASA_ID and MAX_FILE_BYTES --
# and tests/test_client_server_agreement.py fails if they drift.
